.DS_Store
venv/
.venv/
__pycache__
*.log

# Datasets: raw files stay local (large, re-fetched by scripts/fetch-datasets);
# each dataset's exploration/ folder (code, results, logs, report) is tracked.
datasets/*/*
!datasets/*/exploration/
!datasets/*/exploration/**/*.log
datasets/inventory.json
final-project/datasets
# Milestone 2 Data Collection Package: raw files are re-created by package/src/collect.py
reports/milestone-2/package/data/raw/
# Milestone 3 Prepared Data Package: raw is hard-linked from Milestone 2, interim and processed are rebuilt by run_all.sh
reports/milestone-3/package/data/raw/
reports/milestone-3/package/data/interim/
reports/milestone-3/package/data/processed/
# Run logs are the committed record of each step (AGENTS.md, "Keep, commit, submit")
!reports/*/logs/**/*.log
!.agents/skills/*/logs/*.log
# Source downloads are re-fetched by research-report fetch.py (URL in attempts.md); crawl.md is the committed copy
reports/*/research/sources/*/raw.*
!reports/*/package/logs/*.log
# Table page renders are re-created by code/table_audit.py from the built .docx; the measurements are in logs/table_audit_*.log
reports/*/results/table-audit/
