--- script ---
#!/usr/bin/env bash
# Clean-copy test of the Milestone 5 Final Project Package: copy without data, new venv, run_all.sh, compare.
set -u
REPO=/Users/ptkhanh/Documents/master/milestone-da
SRC=$REPO/reports/milestone-5/package
T=/private/tmp/claude-501/-Users-ptkhanh-Documents-master-milestone-da/05a0cc9e-fe77-4f62-aada-6bec7b2bb695/scratchpad/package-test
echo "== $(date -u +%Y-%m-%dT%H:%M:%SZ) clean-copy test start"
rm -rf "$T"; mkdir -p "$T"
echo "\$ rsync -a --exclude data/raw/ --exclude data/interim/ --exclude data/processed/ --exclude __pycache__/ package/ \$T/package/"
rsync -a --exclude 'data/raw/' --exclude 'data/interim/' --exclude 'data/processed/' --exclude '__pycache__/' "$SRC/" "$T/package/"
echo "files copied: $(find "$T/package" -type f | wc -l | tr -d ' '); size without data: $(du -sh "$T/package" | cut -f1) ($(du -sk "$T/package" | cut -f1) KiB)"
ls "$T/package/data"
cd "$T/package" || exit 1
echo "\$ python3 -m venv .venv  ($(python3 --version))"
python3 -m venv .venv || exit 1
echo "\$ .venv/bin/python -m pip install -q -r requirements.txt"
.venv/bin/python -m pip install -q --disable-pip-version-check -r requirements.txt; echo "pip exit $?"
.venv/bin/python -m pip freeze --disable-pip-version-check
echo "\$ PYTHON=.venv/bin/python bash run_all.sh"
start=$(date +%s); PYTHON=.venv/bin/python bash run_all.sh; rc=$?; echo "run_all.sh exit $rc ($(( $(date +%s) - start )) s)"
echo "== raw check (data/metadata/raw_check.csv)"; cat data/metadata/raw_check.csv | cut -d, -f1,2,6
grep -h "anonymisedData\|downloading\|match the pinned" logs/00_collect_raw.log
echo "== prepared views vs version_manifest_published.json (data/metadata/rebuild_check_prepared.csv)"; tail -n +2 logs/07_check_prepared.log
echo "== validation"; grep -h "checks PASS" logs/06_validate.log
echo "== tests"; tail -4 logs/03_tests.log
echo "== aq checks"; grep -h "SUMMARY" logs/11_aq_checks.log
echo "== results vs checksums.csv"; tail -n +2 logs/12_check_results.log
echo "== results vs the Milestone 5 results folder (byte comparison, then value comparison where bytes differ)"
same=0; diff=0
for f in "$REPO"/reports/milestone-5/results/aq*; do b=$(basename "$f")
  if cmp -s "$f" "results/$b"; then same=$((same+1)); else diff=$((diff+1)); echo "BYTES DIFFER: $b"; diff "$f" "results/$b" | head -6; fi
done
echo "byte-identical: $same; differing: $diff; files only in package results: $(cd results && for g in aq*; do [ -e "$REPO/reports/milestone-5/results/$g" ] || printf '%s ' "$g"; done)"
.venv/bin/python - "$REPO/reports/milestone-5/results/aq1_year_comparison.csv" results/aq1_year_comparison.csv <<'PY'
import sys, polars as pl
a, b = pl.read_csv(sys.argv[1]), pl.read_csv(sys.argv[2])
cols = [c for c in a.columns if c != "source"]
print("aq1_year_comparison.csv: shape", a.shape, b.shape, "| all columns except 'source' equal:", a.select(cols).equals(b.select(cols)))
d = a.join(b, on=["level", "group", "year", "measure"], suffix="_pkg").filter(pl.col("source") != pl.col("source_pkg"))
print("rows whose 'source' differs:", d.height, "| distinct pairs:", d.select("source", "source_pkg").unique().rows())
PY
echo "== $(date -u +%Y-%m-%dT%H:%M:%SZ) clean-copy test end; run_all.sh exit $rc"
exit $rc
